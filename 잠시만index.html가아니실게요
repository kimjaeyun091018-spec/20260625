<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, user-scalable=no">
    <title>3D 방탈출: 손전등 · 정전 · 경첩 문</title>
    <script src="https://cdn.babylonjs.com/babylon.js"></script>
    <style>
        html, body { overflow: hidden; width: 100%; height: 100%; margin: 0; padding: 0; background:#000; }
        #renderCanvas { width: 100%; height: 100%; touch-action: none; }
        #game-ui {
            position: absolute; bottom: 10%; left: 50%; transform: translateX(-50%);
            background-color: rgba(0,0,0,0.85); color: #fff; padding: 15px 30px;
            border: 3px solid #fff; border-radius: 8px; font-size: 18px; z-index: 1000;
            pointer-events: none; display: none; text-align: center; font-family: sans-serif;
        }
        #controls-hint {
            position: absolute; top: 12px; left: 12px; color: #fff;
            background: rgba(0,0,0,0.5); padding: 8px 12px; border-radius: 6px;
            font-size: 13px; font-family: sans-serif; z-index: 1000; pointer-events: none;
        }
        #torch-ui {
            position: absolute; top: 12px; right: 12px; color: #ffd; 
            background: rgba(0,0,0,0.5); padding: 8px 12px; border-radius: 6px;
            font-size: 13px; font-family: sans-serif; z-index: 1000; pointer-events: none;
        }
    </style>
</head>
<body>
    <div id="controls-hint">드래그(터치)로 둘러보기 · WASD 이동 · Space 점프 · F 손전등 · 물체 클릭</div>
    <div id="torch-ui">손전등: 꺼짐 (F)</div>
    <div id="game-ui"></div>
    <canvas id="renderCanvas"></canvas>

    <script>
        const canvas = document.getElementById("renderCanvas");
        const engine = new BABYLON.Engine(canvas, true);
        let hasKey = false, doorOpen = false, doorAnimating = false, won = false;

        const uiBox = document.getElementById('game-ui');
        const torchUI = document.getElementById('torch-ui');
        function showMessage(text) {
            uiBox.innerText = text;
            uiBox.style.display = 'block';
            setTimeout(() => { uiBox.style.display = 'none'; }, 3000);
        }

        const createScene = function () {
            const scene = new BABYLON.Scene(engine);
            scene.clearColor = new BABYLON.Color3(0.04, 0.04, 0.06);

            const camera = new BABYLON.UniversalCamera("cam", new BABYLON.Vector3(0, 1.6, 2.5), scene);
            camera.setTarget(new BABYLON.Vector3(0, 1.6, -4));
            camera.attachControl(canvas, true);
            camera.inertia = 0;
            camera.inputs.removeByType("FreeCameraMouseInput");
            camera.inputs.removeByType("FreeCameraTouchInput");
            camera.inputs.removeByType("FreeCameraKeyboardMoveInput");

            scene.collisionsEnabled = true;
            camera.checkCollisions = true;
            camera.applyGravity = false;
            camera.ellipsoid = new BABYLON.Vector3(0.5, 0.8, 0.5);

            // ───────── 재질 ─────────
            const matWall = new BABYLON.StandardMaterial("matWall", scene);
            matWall.diffuseColor = new BABYLON.Color3(0.78, 0.76, 0.72);
            const matFloor = new BABYLON.StandardMaterial("matFloor", scene);
            matFloor.diffuseColor = new BABYLON.Color3(0.32, 0.30, 0.28);
            const matCeil = new BABYLON.StandardMaterial("matCeil", scene);
            matCeil.diffuseColor = new BABYLON.Color3(0.5, 0.48, 0.46);
            const matStair = new BABYLON.StandardMaterial("matStair", scene);
            matStair.diffuseColor = new BABYLON.Color3(0.45, 0.38, 0.32);

            // ───────── 헬퍼 ─────────
            function makeWall(x, y, z, w, h, d, mat) {
                const b = BABYLON.MeshBuilder.CreateBox("wall", {width:w, height:h, depth:d}, scene);
                b.position.set(x, y, z); b.material = mat || matWall; b.checkCollisions = true; return b;
            }
            function makeFloor(x, y, z, w, d, mat) {
                const f = BABYLON.MeshBuilder.CreateBox("floor", {width:w, height:0.2, depth:d}, scene);
                f.position.set(x, y - 0.1, z); f.material = mat || matFloor;
                f.isWalkable = true; f.checkCollisions = false; return f;
            }
            function makeCeiling(x, y, z, w, d, mat) {
                const c = BABYLON.MeshBuilder.CreateBox("ceiling", {width:w, height:0.2, depth:d}, scene);
                c.position.set(x, y, z); c.material = mat || matCeil; return c;
            }
            function makeDoorwayWall(z, totalW, height, gapW, gapH, mat) {
                const side = (totalW - gapW) / 2;
                makeWall(-(gapW/2 + side/2), height/2, z, side, height, 0.2, mat);
                makeWall( (gapW/2 + side/2), height/2, z, side, height, 0.2, mat);
                makeWall(0, (gapH + height)/2, z, gapW, height - gapH, 0.2, mat);
            }
            function makeStairs(x, baseY, startZ, steps, stepW, stepH, stepD, dir, mat) {
                for (let i = 0; i < steps; i++) {
                    const top = baseY + (i + 1) * stepH;
                    const s = BABYLON.MeshBuilder.CreateBox("step", {width:stepW, height:(top-baseY), depth:stepD}, scene);
                    s.position.set(x, baseY + (top-baseY)/2, startZ + dir * (i * stepD));
                    s.material = mat || matStair; s.isWalkable = true; s.checkCollisions = false;
                }
                return baseY + steps * stepH;
            }

            // ───────── 맵 ─────────
            makeFloor(0, 0, -8, 26, 40, matFloor);
            makeWall(0, 1.5, 4, 8, 3, 0.2);
            makeWall(-4, 1.5, 0, 0.2, 3, 8);
            makeWall(4, 1.5, 0, 0.2, 3, 8);
            makeCeiling(0, 3, 0, 8, 8);
            makeDoorwayWall(-4, 8, 6, 2, 2.6);
            makeWall(-4, 3, -8, 0.2, 6, 8);
            makeWall(4, 3, -8, 0.2, 6, 8);
            makeCeiling(0, 6, -8, 8, 8);
            makeDoorwayWall(-12, 8, 6, 2, 2.6);
            const loftY = makeStairs(2.75, 0, -5, 10, 1.5, 0.3, 0.4, -1);
            makeFloor(0, loftY, -10.25, 8, 3.5, matStair);
            makeWall(-1.5, loftY + 0.5, -9, 5, 1, 0.2);

            // ───────── ✅ 경첩(hinge) 문 ─────────
            // 문 메시를 그냥 회전하면 중심축으로 돈다. TransformNode 를 문 '왼쪽 가장자리'에 두고
            // 문을 그 자식으로 붙이면, 그 축을 기준으로 진짜 경첩처럼 한쪽만 열린다.
            const DOOR_W = 1.8, DOOR_H = 2.6, DOOR_Z = -11.9;
            const hinge = new BABYLON.TransformNode("hinge", scene);
            hinge.position.set(-DOOR_W / 2, 0, DOOR_Z);   // 문 왼쪽 모서리 = 회전축

            const door = BABYLON.MeshBuilder.CreateBox("door", {width:DOOR_W, height:DOOR_H, depth:0.15}, scene);
            door.parent = hinge;
            door.position.set(DOOR_W / 2, DOOR_H / 2, 0); // 경첩에서 오른쪽으로 반 폭만큼 밀어 배치
            const doorMat = new BABYLON.StandardMaterial("doorMat", scene);
            doorMat.diffuseColor = new BABYLON.Color3(0.35, 0.18, 0.09);
            door.material = doorMat;
            door.checkCollisions = true;

            const OPEN_ANGLE = -Math.PI / 2; // 한쪽 방향(바깥쪽)으로만 90도

            // 열쇠
            const key = BABYLON.MeshBuilder.CreateBox("key", {width:0.3, height:0.3, depth:0.3}, scene);
            key.position.set(0, loftY + 0.4, -10.5);
            const keyMat = new BABYLON.StandardMaterial("keyMat", scene);
            keyMat.diffuseColor = new BABYLON.Color3(1, 0.78, 0);
            keyMat.emissiveColor = new BABYLON.Color3(0.7, 0.52, 0); // 정전 후에도 스스로 빛남
            key.material = keyMat;

            const exitPad = BABYLON.MeshBuilder.CreateGround("exitPad", {width:3, height:3}, scene);
            exitPad.position.set(0, 0.03, -14.5);
            const exitMat = new BABYLON.StandardMaterial("exitMat", scene);
            exitMat.diffuseColor = new BABYLON.Color3(0.2, 0.8, 0.3);
            exitMat.emissiveColor = new BABYLON.Color3(0.1, 0.4, 0.15);
            exitPad.material = exitMat;
            exitPad.isWalkable = true; exitPad.checkCollisions = false;

            // ───────── 방 조명 (정전 대상) ─────────
            const amb = new BABYLON.HemisphericLight("amb", new BABYLON.Vector3(0, 1, 0), scene);
            amb.intensity = 0.5;
            const lampA = new BABYLON.PointLight("lampA", new BABYLON.Vector3(0, 2.6, 0), scene);
            lampA.intensity = 0.6;
            const lampB = new BABYLON.PointLight("lampB", new BABYLON.Vector3(0, 4.5, -9), scene);
            lampB.intensity = 0.7;
            const roomLights = [amb, lampA, lampB];

            // ───────── ✅ 손전등 (카메라에 부착 → 시선을 그대로 따라감) ─────────
            const torch = new BABYLON.SpotLight(
                "torch",
                new BABYLON.Vector3(0, 0, 0),        // 부모(카메라) 기준 위치
                new BABYLON.Vector3(0, 0, 1),        // 카메라 로컬 정면
                Math.PI / 5,                          // 원뿔 각도(빛 퍼짐)
                8,                                    // exponent (가장자리 감쇠)
                scene
            );
            torch.parent = camera;                    // ← 이 한 줄로 시선 추적 완료
            torch.intensity = 0;                      // 시작은 꺼짐
            torch.range = 22;
            torch.diffuse = new BABYLON.Color3(1, 0.96, 0.85);

            let torchOn = false;
            const TORCH_POWER = 2.2;
            function setTorch(on) {
                torchOn = on;
                torch.intensity = on ? TORCH_POWER : 0;
                torchUI.innerText = on ? "손전등: 켜짐 (F)" : "손전등: 꺼짐 (F)";
            }
            window.addEventListener("keydown", e => {
                if (e.code === "KeyF") setTorch(!torchOn);
            });

            // ───────── ✅ 정전 연출 (열쇠 획득 시 방 불이 서서히 꺼짐) ─────────
            let blackout = false;
            function triggerBlackout() {
                blackout = true;
                if (!torchOn) setTorch(true); // 완전 암흑 방지: 손전등 자동 점등
            }
            scene.onBeforeRenderObservable.add(() => {
                if (!blackout) return;
                let done = true;
                roomLights.forEach(l => {
                    if (l.intensity > 0.001) { l.intensity *= 0.90; done = false; } // 부드럽게 감쇠
                    else l.intensity = 0;
                });
                if (done) blackout = false;
            });

            // ───────── 시선 조작 ─────────
            const LOOK_SENS = 0.004;
            let dragging = false, lastX = 0, lastY = 0;
            canvas.addEventListener("pointerdown", e => { dragging = true; lastX = e.clientX; lastY = e.clientY; });
            const stopDrag = () => dragging = false;
            canvas.addEventListener("pointerup", stopDrag);
            canvas.addEventListener("pointerleave", stopDrag);
            canvas.addEventListener("pointercancel", stopDrag);
            canvas.addEventListener("pointermove", e => {
                if (!dragging) return;
                camera.rotation.y += (e.clientX - lastX) * LOOK_SENS;
                camera.rotation.x += (e.clientY - lastY) * LOOK_SENS;
                lastX = e.clientX; lastY = e.clientY;
            });
            scene.onBeforeRenderObservable.add(() => {
                if (camera.rotation.x > 1.2) camera.rotation.x = 1.2;
                if (camera.rotation.x < -1.2) camera.rotation.x = -1.2;
            });

            // ───────── 수평 이동 ─────────
            const MOVE_SPEED = 3.2;
            const keys = {};
            window.addEventListener("keydown", e => { keys[e.code] = true; });
            window.addEventListener("keyup",   e => { keys[e.code] = false; });
            scene.onBeforeRenderObservable.add(() => {
                const yaw = camera.rotation.y;
                const forward = new BABYLON.Vector3(Math.sin(yaw), 0, Math.cos(yaw));
                const right   = new BABYLON.Vector3(Math.cos(yaw), 0, -Math.sin(yaw));
                const move = BABYLON.Vector3.Zero();
                if (keys["KeyW"]) move.addInPlace(forward);
                if (keys["KeyS"]) move.subtractInPlace(forward);
                if (keys["KeyD"]) move.addInPlace(right);
                if (keys["KeyA"]) move.subtractInPlace(right);
                if (move.lengthSquared() > 0) {
                    const dt = engine.getDeltaTime() / 1000;
                    move.normalize().scaleInPlace(MOVE_SPEED * dt);
                }
                camera.cameraDirection.copyFrom(move);
            });

            // ───────── 세로 이동 (ground-follow) ─────────
            const EYE = 1.6, GRAV = -0.02, JUMP_V = 0.2;
            let velY = 0, grounded = true;
            window.addEventListener("keydown", e => {
                if (e.code === "Space" && grounded) { velY = JUMP_V; grounded = false; }
            });
            const DOWN = new BABYLON.Vector3(0, -1, 0);
            scene.onBeforeRenderObservable.add(() => {
                const origin = camera.position.add(new BABYLON.Vector3(0, 0.1, 0));
                const hit = scene.pickWithRay(new BABYLON.Ray(origin, DOWN, 12), m => m.isWalkable === true);
                const floorY = (hit && hit.hit) ? hit.pickedPoint.y : -Infinity;
                const targetY = floorY + EYE;
                if (grounded) {
                    const diff = targetY - camera.position.y;
                    if (diff > 0.01) camera.position.y += Math.min(diff, 0.18);
                    else if (diff < -0.6) { grounded = false; velY = 0; }
                    else if (diff < -0.01) camera.position.y += Math.max(diff, -0.18);
                    else camera.position.y = targetY;
                } else {
                    velY += GRAV;
                    camera.position.y += velY;
                    if (camera.position.y <= targetY) { camera.position.y = targetY; velY = 0; grounded = true; }
                }
            });

            scene.onBeforeRenderObservable.add(() => { if (key.visibility > 0) key.rotation.y += 0.03; });

            // ───────── ✅ 문 애니메이션 (열림 / 흔들림) ─────────
            function openDoor() {
                doorAnimating = true;
                const start = performance.now(), DUR = 900;
                const anim = () => {
                    const t = Math.min((performance.now() - start) / DUR, 1);
                    const ease = 1 - Math.pow(1 - t, 3); // ease-out
                    hinge.rotation.y = OPEN_ANGLE * ease;
                    if (t < 1) requestAnimationFrame(anim);
                    else { doorAnimating = false; door.checkCollisions = false; }
                };
                anim();
            }
            function rattleDoor() {
                doorAnimating = true;
                const start = performance.now(), DUR = 450, AMP = 0.05; // 살짝 덜컹
                const anim = () => {
                    const t = (performance.now() - start) / DUR;
                    if (t < 1) {
                        // 진동하며 점점 잦아듦
                        hinge.rotation.y = Math.sin(t * Math.PI * 6) * AMP * (1 - t);
                        requestAnimationFrame(anim);
                    } else { hinge.rotation.y = 0; doorAnimating = false; }
                };
                anim();
            }

            // ───────── 상호작용 ─────────
            scene.onPointerDown = function (evt, pickResult) {
                if (!pickResult.hit) return;
                const mesh = pickResult.pickedMesh;
                if (mesh === key && !hasKey) {
                    hasKey = true;
                    key.visibility = 0;
                    showMessage('황금 열쇠를 주웠다... 갑자기 불이 꺼졌다!');
                    triggerBlackout(); // ← 열쇠 획득 = 정전
                } else if (mesh === door && !doorAnimating) {
                    if (hasKey && !doorOpen) {
                        doorOpen = true;
                        openDoor();
                        showMessage('문이 열렸다! 밖으로 나가자.');
                    } else if (!hasKey) {
                        rattleDoor();      // ← 잠김: 흔들리기만
                        showMessage('덜컹! 문이 잠겨 있다. 다락의 열쇠를 찾아보자.');
                    }
                }
            };

            scene.onBeforeRenderObservable.add(() => {
                if (doorOpen && !won && camera.position.z < -12.6) { won = true; showMessage('탈출 성공!'); }
            });

            return scene;
        };

        const scene = createScene();
        engine.runRenderLoop(() => scene.render());
        window.addEventListener("resize", () => engine.resize());
    </script>
</body>
</html>
